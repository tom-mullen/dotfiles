{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go fmt:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy)",
      "Bash(golangci-lint:*)",
      "Bash(goimports:*)",
      "Bash(staticcheck:*)",
      "Bash(gosec:*)",
      "Bash(deadcode:*)",
      "Bash(task:*)",
      "Bash(lefthook:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(gh pr comment:*)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "hey@37signals": true
  },
  "extraKnownMarketplaces": {
    "37signals": {
      "source": {
        "source": "github",
        "repo": "basecamp/claude-plugins"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agents": {
    "git-expert": {
      "source": "~/.claude/agents/git-expert.md"
    },
    "lead-engineer": {
      "source": "~/.claude/agents/lead-engineer.md"
    },
    "security-reviewer": {
      "source": "~/.claude/agents/security-reviewer.md"
    },
    "test-writer": {
      "source": "~/.claude/agents/test-writer.md"
    }
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(git push origin <branch>) and Bash(git -C <path> push [-u] origin <branch>) for a non-default feature branch (e.g. feat/*, fix/*, chore/*, docs/*, test/*, refactor/*) in a Standard-Innovation GitHub repo, as a plain fast-forward push that runs the repo hooks (no --no-verify)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(si op set:*) — writes to shared 1Password vaults",
      "Bash(kamal setup:*) and Bash(kamal deploy:*) — host provisioning and deploys of Kamal services",
      "Bash(git push) with --force, --force-with-lease, -f, a +refspec, --no-verify, --delete or --mirror; any push to main or master; any push of tags (--tags, --follow-tags, refs/tags/*, a v* tag)"
    ]
  }
}
